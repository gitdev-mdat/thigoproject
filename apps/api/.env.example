# Local Docker Compose default. Replace with any PostgreSQL-compatible provider URL.
DATABASE_URL=postgresql://thigo:thigo@localhost:5432/thigo

# Optional API/runtime settings.
PORT=3001
DATABASE_CONNECT_TIMEOUT_MS=3000

# Local development fixtures (seed accounts, demo catalog and images, fixed
# OTP 000000) are off unless you opt in on your own machine. They need BOTH
# lines below uncommented; NODE_ENV must be development or test. Never set
# them in a deployed environment: production refuses to start with the flag.
# NODE_ENV=development
# THIGO_ENABLE_DEV_FIXTURES=true

# OTP provider. "test" (fixed code 000000) works only with the fixture opt-in
# above and is always rejected when NODE_ENV=production.
OTP_PROVIDER=disabled
OTP_EXPIRY_SECONDS=300
OTP_ATTEMPT_LIMIT=5
OTP_RESEND_SECONDS=60
SESSION_EXPIRY_SECONDS=2592000
ADMIN_COOKIE_NAME=thigo_admin_session
ADMIN_WEB_ORIGIN=http://localhost:3000
