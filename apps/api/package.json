{
  "name": "@thigo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migration:create": "typeorm migration:create --esm",
    "db:migration:generate": "typeorm-ts-node-esm migration:generate -d src/data-source.ts --esm",
    "db:migrate": "typeorm-ts-node-esm migration:run -d src/data-source.ts",
    "db:migrate:revert": "typeorm-ts-node-esm migration:revert -d src/data-source.ts",
    "db:migration:show": "typeorm-ts-node-esm migration:show -d src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/typeorm": "12.0.2",
    "dotenv": "17.2.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@thigo/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
